#!/usr/bin/env envstack
# One compatible platform/architecture/Python runtime per deployment root.
all:
  ROOT: ${ROOT:-${HOME}/.local/distman-examples/flat}
  ENV: ${ENV:-dev}
  DEPLOY_ROOT: ${DEPLOY_ROOT:-${ROOT}/${ENV}}
  TOOLS_ROOT: ${TOOLS_ROOT:-${DEPLOY_ROOT}/tools}
  DISTMAN_SHARED_LIB_PATH: ${TOOLS_ROOT}/lib/python
  DISTMAN_RUNTIME_LIB_PATH: ${DISTMAN_SHARED_LIB_PATH}
  DISTMAN_TARGET_PATH: ${DISTMAN_SHARED_LIB_PATH}
  PYTHONPATH: ${DISTMAN_SHARED_LIB_PATH}:${PYTHONPATH}
  # Wheel scripts currently live inside the import root.
  PATH: ${TOOLS_ROOT}/bin:${DISTMAN_SHARED_LIB_PATH}/bin:${PATH}
