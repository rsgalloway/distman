#!/usr/bin/env envstack
include: [tools]
all: &all
  NUMPY_VERSION: ${NUMPY_VERSION:-2.2.6}
  NUMPY_ROOT: ${NUMPY_ROOT:-${TOOLS_ROOT}/numpy/${NUMPY_VERSION}}
  # Set these from the application's interpreter before activation; see README.
  PYVERSION: ${PYVERSION:-3.11}
  PYARCH: ${PYARCH:-x86_64}
  NUMPY_PYTHON_ROOT: ${NUMPY_ROOT}/${PYPLATFORM}/${PYARCH}/python${PYVERSION}/lib/python
  PYTHONPATH: ${NUMPY_PYTHON_ROOT}:${PYTHONPATH}
  PATH: ${NUMPY_PYTHON_ROOT}/bin:${PATH}
linux:
  <<: *all
  PYPLATFORM: linux
windows:
  <<: *all
  PYPLATFORM: windows
darwin:
  <<: *all
  PYPLATFORM: darwin
